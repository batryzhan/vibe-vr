{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_SITE_URL", "VERCEL_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "PORT",
        "LOG_LEVEL",
        "NODE_ENV",
        "VIBE_VR_PLATFORM",
        "VIBE_VR_MODEL",
        "DAHL_API_KEY",
        "ALEM_API_KEY",
        "ALEM_BASE_URL",
        "ALEM_MODEL",
        "DAHL_BASE_URL",
        "DAHL_PRIMARY_MODEL",
        "DAHL_SPATIAL_MODEL",
        "DAHL_COMPOSITION_MODEL",
        "DAHL_REQUEST_TIMEOUT_MS",
        "DAHL_MAX_ATTEMPTS",
        "DAHL_MAX_CONCURRENCY",
        "DAHL_MAX_PARALLEL_AGENTS",
        "DAHL_MAX_ORCHESTRATION_ROUNDS",
        "DAHL_MAX_COMPLETION_TOKENS",
        "VIBE_VR_EFFORT",
        "OPENROUTER_API_KEY",
        "VIBE_VR_EVENT_BUS"
      ]
    },
    "dev:worker": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "LOG_LEVEL",
        "NODE_ENV",
        "VIBE_VR_PLATFORM",
        "VIBE_VR_MODEL",
        "DAHL_API_KEY",
        "ALEM_API_KEY",
        "ALEM_BASE_URL",
        "ALEM_MODEL",
        "DAHL_BASE_URL",
        "DAHL_PRIMARY_MODEL",
        "DAHL_SPATIAL_MODEL",
        "DAHL_COMPOSITION_MODEL",
        "DAHL_REQUEST_TIMEOUT_MS",
        "DAHL_MAX_ATTEMPTS",
        "DAHL_MAX_CONCURRENCY",
        "DAHL_MAX_PARALLEL_AGENTS",
        "DAHL_MAX_ORCHESTRATION_ROUNDS",
        "DAHL_MAX_COMPLETION_TOKENS",
        "VIBE_VR_EFFORT",
        "OPENROUTER_API_KEY",
        "VIBE_VR_EVENT_BUS",
        "VIBE_VR_WORKER_CONCURRENCY",
        "VIBE_VR_DRAIN_TIMEOUT_SECONDS",
        "VIBE_VR_CAPTURE_CONCURRENCY",
        "VIBE_VR_CHROME_PATH"
      ]
    },
    "dev:reaper": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "VIBE_VR_LISTEN_DATABASE_URL",
        "LOG_LEVEL",
        "NODE_ENV",
        "VIBE_VR_PLATFORM",
        "VIBE_VR_MODEL",
        "DAHL_API_KEY",
        "ALEM_API_KEY",
        "ALEM_BASE_URL",
        "ALEM_MODEL",
        "DAHL_BASE_URL",
        "DAHL_PRIMARY_MODEL",
        "DAHL_SPATIAL_MODEL",
        "DAHL_COMPOSITION_MODEL",
        "DAHL_REQUEST_TIMEOUT_MS",
        "DAHL_MAX_ATTEMPTS",
        "DAHL_MAX_CONCURRENCY",
        "DAHL_MAX_PARALLEL_AGENTS",
        "DAHL_MAX_ORCHESTRATION_ROUNDS",
        "DAHL_MAX_COMPLETION_TOKENS",
        "VIBE_VR_EFFORT",
        "OPENROUTER_API_KEY",
        "VIBE_VR_EVENT_BUS",
        "VIBE_VR_REAP_INTERVAL_SECONDS",
        "VIBE_VR_REAP_IDLE_MINUTES",
        "VIBE_VR_JANITOR_INTERVAL_SECONDS"
      ]
    }
  }
}
