# Local PostgreSQL from infra/docker-compose.yml
DATABASE_URL=postgres://nap:nap@localhost:5433/nap

# Generate separate random secrets for this machine. VIBE_VR_KEY_ENCRYPTION_SECRET must decode to 32 bytes.
BETTER_AUTH_SECRET=replace-with-a-random-secret
VIBE_VR_KEY_ENCRYPTION_SECRET=replace-with-32-random-bytes-in-base64

# A local machine uses local snapshots instead of Cloudflare R2.
VIBE_VR_OBJECT_STORE=local
VIBE_VR_EVENT_BUS=postgres
VIBE_VR_WEB_ORIGIN=http://localhost:3000
VIBE_VR_API_URL=http://localhost:3001
VIBE_VR_ALLOW_DEMO=true

# Alem AI chat completions: keep the key in this server-side file, never the browser.
VIBE_VR_PLATFORM=alem
ALEM_API_KEY=replace-with-your-alem-api-key
ALEM_BASE_URL=https://llm.alem.ai/v1
ALEM_MODEL=qwen3-8
VIBE_VR_MODEL=qwen3-8
VIBE_VR_FREE_MODEL=qwen3-8
VIBE_VR_ALLOWED_MODELS=qwen3-8
